#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer BufA { float a[]; };
layout(std430, binding = 1) writeonly buffer BufO { float o[]; };
layout(std430, binding = 2) readonly  buffer BufP { uint n; uint op; uint p2; uint p3; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    float x = a[i];
    float r;
    if      (op == 0u) r = max(x, 0.0);
    else if (op == 1u) r = -x;
    else if (op == 2u) r = exp(x);
    else if (op == 3u) r = sqrt(x);
    else if (op == 4u) r = x * x;
    else if (op == 5u) r = 1.0 / (1.0 + exp(-x));
    else if (op == 6u) r = tanh(x);
    else if (op == 7u) r = abs(x);
    else if (op == 8u) r = log(x);
    else if (op == 9u) r = 1.0 / x;
    else               r = inversesqrt(x);
    o[i] = r;
}
